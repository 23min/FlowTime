// flowtime-vnext devcontainer — generated by devcontainer-kit; change answers with `uvx copier update`.
// Project-specific steps belong in .devcontainer/project/. See .devcontainer/README.md.
{
  "name": "flowtime-vnext",
  "build": { "dockerfile": "Dockerfile", "context": "." },

  // Static name: identifiable in Docker Desktop, and a stale duplicate fails loudly on the name
  // clash instead of piling up under random names. The env file carries the host's git identity
  // (written by initialize.sh on the host).
  "runArgs": [
    "--name", "flowtime-vnext-dev",
    "--hostname", "flowtime-vnext-dev",
    "--env-file", "${localWorkspaceFolder}/.devcontainer/.host.env",
    // The .NET debugger attaches to processes, which needs ptrace.
    "--cap-add=SYS_PTRACE",
    "--security-opt", "seccomp=unconfined"
  ],

  // Only this repo is mounted. Sibling repos are listed explicitly (read-only by default).
  "workspaceFolder": "/workspaces/flowtime-vnext",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/flowtime-vnext,type=bind,consistency=cached",

  // Runs on the HOST: creates mount sources, the /tmp/.flowtime-vnext-* links the mounts use,
  // .host.env and the weekly refresh marker.
  "initializeCommand": "bash .devcontainer/initialize.sh",

  // Host state goes through /tmp/.flowtime-vnext-* links made by initialize.sh (Mac $HOME is always
  // right there); package caches are named volumes shared by every kit container.
  "mounts": [
    "source=/tmp/.flowtime-vnext-claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=/tmp/.flowtime-vnext-claude-plugins,target=/home/vscode/.claude/plugins,type=bind,consistency=cached",
    "source=/tmp/.flowtime-vnext-gh,target=/home/vscode/.config/gh,type=bind,consistency=cached",
    "source=/tmp/.flowtime-vnext-codex,target=/home/vscode/.codex,type=bind,consistency=cached",
    "source=/tmp/.flowtime-vnext-guidance,target=/home/vscode/.guidance,type=bind,consistency=cached",
    "source=devkit-cache-uv,target=/home/vscode/.cache/uv,type=volume",
    "source=devkit-cache-npm,target=/home/vscode/.npm,type=volume",
    "source=devkit-cache-go-mod,target=/home/vscode/go/pkg/mod,type=volume",
    "source=devkit-cache-go-build,target=/home/vscode/.cache/go-build,type=volume",
    "source=devkit-cache-cargo-registry,target=/home/vscode/.cargo/registry,type=volume",
    "source=devkit-cache-cargo-git,target=/home/vscode/.cargo/git,type=volume",
    "source=devkit-cache-nuget,target=/home/vscode/.nuget/packages,type=volume"
  ],

  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "lts"
    }
  },

  "containerEnv": {
    "DEVKIT_SLUG": "flowtime-vnext",
    "UV_LINK_MODE": "copy",
    // MSBuild runs its build nodes out of process.
    "MSBUILDNOINPROCNODE": "1"
  },

  "forwardPorts": [5173, 5219, 8081, 8090, 8091],
  // The Blazor WebAssembly UI runs in the host's browser and calls 8081, 8090 and 8091 on
  // localhost directly, so VS Code must forward them to the same port numbers.
  "portsAttributes": {
    "5173": {
      "label": "Svelte UI"
    },
    "5219": {
      "label": "Blazor UI"
    },
    "8081": {
      "label": "FlowTime API",
      "requireLocalPort": true
    },
    "8090": {
      "label": "FlowTime Sim API",
      "requireLocalPort": true
    },
    "8091": {
      "label": "Sim API fallback",
      "requireLocalPort": true
    }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "remoteUser": "vscode",

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "openai.chatgpt",
        "mhutchie.git-graph",
        "redhat.vscode-yaml",
        "editorconfig.editorconfig",
        "rust-lang.rust-analyzer",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "github.vscode-github-actions",
        "GitHub.copilot",
        "github.copilot-chat",
        "humao.rest-client",
        "shd101wyy.markdown-preview-enhanced",
        "svelte.svelte-vscode"
      ],
      "settings": {
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        },
        "editor.formatOnSave": true,
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  }
}
